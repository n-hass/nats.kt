package = io.natskt.tls.openssl
# libssl.a + libcrypto.a are linked via com.ensody.nativebuilds:openssl-libssl, whose
# klib bundles them under targets/<t>/included/ for Kotlin/Native to pick up. The
# previous `linkerOpts = -lssl -lcrypto` failed when cross-compiling from macOS
# because the LLD cross-linker has no Linux libssl/libcrypto on its search path.
---
// Opaque types
typedef struct x509_st X509;
typedef struct x509_store_st X509_STORE;
typedef struct x509_store_ctx_st X509_STORE_CTX;
typedef struct stack_st OPENSSL_STACK;
typedef struct ssl_ctx_st SSL_CTX;
typedef struct ssl_st SSL;
typedef struct ssl_method_st SSL_METHOD;

// X.509
X509 *d2i_X509(X509 **px, const unsigned char **in, long len);
void X509_free(X509 *a);

X509_STORE *X509_STORE_new(void);
void X509_STORE_free(X509_STORE *v);
int X509_STORE_set_default_paths(X509_STORE *ctx);
int X509_STORE_add_cert(X509_STORE *ctx, X509 *x);

X509_STORE_CTX *X509_STORE_CTX_new(void);
void X509_STORE_CTX_free(X509_STORE_CTX *ctx);
int X509_STORE_CTX_init(X509_STORE_CTX *ctx, X509_STORE *trust_store, X509 *target, OPENSSL_STACK *chain);
int X509_verify_cert(X509_STORE_CTX *ctx);
int X509_STORE_CTX_get_error(X509_STORE_CTX *ctx);
const char *X509_verify_cert_error_string(long n);

int X509_check_host(X509 *x, const char *chk, unsigned long chklen, unsigned int flags, char **peername);
int X509_check_ip_asc(X509 *x, const char *ipasc, unsigned int flags);

OPENSSL_STACK *OPENSSL_sk_new_null(void);
int OPENSSL_sk_push(OPENSSL_STACK *st, const void *data);
void OPENSSL_sk_free(OPENSSL_STACK *st);

// libssl (OpenSSL 3.x — these are real symbols, not macros)
const SSL_METHOD *TLS_client_method(void);
SSL_CTX *SSL_CTX_new(const SSL_METHOD *method);
void SSL_CTX_free(SSL_CTX *ctx);
int SSL_CTX_set_default_verify_paths(SSL_CTX *ctx);
void SSL_CTX_set_cert_store(SSL_CTX *ctx, X509_STORE *store);
X509_STORE *SSL_CTX_get_cert_store(const SSL_CTX *ctx);

// SSL_CTX_set_min_proto_version is a macro wrapping SSL_CTX_ctrl:
//   #define SSL_CTX_set_min_proto_version(ctx, version) \
//       SSL_CTX_ctrl(ctx, SSL_CTRL_SET_MIN_PROTO_VERSION, version, NULL)
// Use SSL_CTX_ctrl directly from Kotlin with cmd=123 (SSL_CTRL_SET_MIN_PROTO_VERSION).
long SSL_CTX_ctrl(SSL_CTX *ctx, int cmd, long larg, void *parg);

SSL *SSL_new(SSL_CTX *ctx);
void SSL_free(SSL *ssl);
int SSL_set_fd(SSL *ssl, int fd);
int SSL_set1_host(SSL *ssl, const char *hostname);
void SSL_set_verify(SSL *ssl, int mode, void *callback);

// SNI is exposed only as a macro in <openssl/ssl.h>:
//   #define SSL_set_tlsext_host_name(s, name) \
//       SSL_ctrl(s, SSL_CTRL_SET_TLSEXT_HOSTNAME, TLSEXT_NAMETYPE_host_name, (void*)name)
// Use SSL_ctrl directly from Kotlin with cmd=55 (SSL_CTRL_SET_TLSEXT_HOSTNAME),
// larg=0 (TLSEXT_NAMETYPE_host_name).
long SSL_ctrl(SSL *ssl, int cmd, long larg, void *parg);

int SSL_connect(SSL *ssl);
int SSL_shutdown(SSL *ssl);
int SSL_read(SSL *ssl, void *buf, int num);
int SSL_write(SSL *ssl, const void *buf, int num);
int SSL_get_error(const SSL *ssl, int ret);
const char *SSL_get_version(const SSL *ssl);

unsigned long ERR_get_error(void);
void ERR_error_string_n(unsigned long e, char *buf, unsigned long len);
